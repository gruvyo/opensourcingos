    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "brace-expansion@<1.1.18": "1.1.18",
    "brace-expansion@>=4.0.0 <5.0.9": "5.0.9",
    "sharp@<0.35.0": "0.35.0"
  }
