    "test:safe-external-url": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test scripts/safe-external-url.test.mts",
    "test:schedule-date-persistence": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test scripts/schedule-date-persistence.test.mts",
